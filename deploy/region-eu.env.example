# EU regional deployment settings.
# Deploy this stack in the EU cloud region with EU-resident PostgreSQL/Redis.
VEILOPS_REGION=eu
INGEST_BASE_URL=https://eu-ingest.REPLACE_WITH_YOUR_DOMAIN/v1
POSTGRES_PASSWORD=replace-with-region-specific-secret
COLLECTOR_SECRET_ENCRYPTION_KEY=replace-with-region-specific-url-safe-base64-key
SAAS_ED25519_PRIVATE_KEY=replace-with-region-specific-url-safe-base64-seed
DASHBOARD_JWT_SECRET=replace-with-region-specific-random-secret

# For a separate EU deployment host, copy this file to a protected .env file,
# replace every placeholder, then run:
# docker compose --env-file .env -p veilops-eu -f deploy/docker-compose.yml up -d --build
# Add --profile edge only after VEILOPS_DOMAIN and ACME_EMAIL are configured.
# Never deploy with the placeholder secrets or placeholder ingest hostname.
VEILOPS_DOMAIN=replace-with-eu-api-domain.example
ACME_EMAIL=replace-with-operations-email@example.com
